# Copy to .env and fill in. Only TELEGRAM_BOT_TOKEN is required —
# everything else has sensible defaults (see src/config.js for the full list).

# --- Required ---------------------------------------------------------------
# Get this from @BotFather on Telegram (see README "Telegram setup").
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token-here

# Optional: pin the chat that receives alerts. If left empty, the first person
# to message the bot becomes the bound chat automatically.
TELEGRAM_CHAT_ID=

# --- What to watch (defaults: The Odyssey, IMAX 70mm, AMC Lincoln Square 13) --
#AMC_THEATRE_PATH=/movie-theatres/new-york-city/amc-lincoln-square-13/showtimes
#AMC_THEATRE_NAME=AMC Lincoln Square 13
#MOVIE_SLUG_PATTERN=the-odyssey
#MOVIE_TITLE=The Odyssey
#FORMAT_PATTERN=^IMAX\s*70\s*MM$
#FORMAT_DISPLAY=IMAX 70mm

# --- Polling ------------------------------------------------------------------
#POLL_INTERVAL_MS=60000
#POLL_JITTER_MS=20000
#LOOKAHEAD_DAYS=28
#MAX_PAGES_PER_CYCLE=4
#QUEUE_WAIT_MS=90000   # max time to sit in AMC's Queue-it waiting room

# --- Daily heartbeat ------------------------------------------------------------
#DAILY_SUMMARY_HOUR=9
#TIMEZONE=America/New_York

# --- Browser overrides (rarely needed on a normal droplet) ---------------------
#CHROME_EXECUTABLE=
#BROWSER_PROXY=
#EXTRA_CHROMIUM_ARGS=
#HEADLESS=1

# --- State ---------------------------------------------------------------------
#STATE_FILE=./data/state.json
#LOG_FILE=
